# ==============================================================================
# KHMER TRANSLATOR 2.0 - BACKEND PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# Application Meta
APP_NAME="Khmer Translator API"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Server Bind Address
HOST="0.0.0.0"
PORT=8000

# Media and Output Storage Paths (Relative or Absolute)
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
JOBS_FILE="jobs.json"
MAX_UPLOAD_MB=2048

# Speech Recognition (faster-whisper INT8 CPU Engine)
DEFAULT_WHISPER_MODEL="tiny"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Production Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

