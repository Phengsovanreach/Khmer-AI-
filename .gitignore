# ==============================================================================
# KHMER TRANSLATOR & KHMER AI — GITIGNORE CONFIGURATION
# ==============================================================================

# Environment and sensitive credential files
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python dependencies and virtual environments
.venv/
venv/
ENV/
env/
*.py[cod]
*$py.class
__pycache__/
*.so

# Python test and coverage caches
.pytest_cache/
.coverage
htmlcov/

# Node.js dependencies and build outputs
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated media and local processing outputs (keep directories via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# Local job database containing user session history
backend/jobs.json
backend/jobs.json.tmp

# Backup folders
_backups/

# Logs and runtime data
*.log
*.tmp
*.swp
*.swo

# OS system files
.DS_Store
Thumbs.db
desktop.ini
