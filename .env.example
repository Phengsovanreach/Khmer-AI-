# ==============================================================================
# KHMER TRANSLATOR AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
APP_NAME="Khmer Translator API"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
APP_BASE_URL="https://khmer-ai-1ktp.onrender.com"

# Network & Server Configuration
HOST="0.0.0.0"
PORT=8000

# Allowed Cross-Origin Origins (CORS)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://khmer-ai-16c.pages.dev"

# Storage Directories & Limits
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
JOBS_FILE="jobs.json"
MAX_UPLOAD_MB=2048

# Speech-to-Text & Quantized AI Models
DEFAULT_WHISPER_MODEL="tiny"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL in production, SQLite fallback in dev)
# ------------------------------------------------------------------------------
# Production PostgreSQL example: postgresql://username:password@db.render.com:5432/khmer_db
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# TELEGRAM BOT ALERTS (Official Telegram Bot API)
# ------------------------------------------------------------------------------
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALWAYS_NOTIFY=true

# ------------------------------------------------------------------------------
# AUTONOMOUS AI SRE AGENT & ROOT-CAUSE ANALYSIS
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-3.5-flash-lite"
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# GITHUB AUTOMATION & CI/CD
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY="Phengsovanreach/Khmer-AI-"
PRODUCTION_BRANCH="main"

# ------------------------------------------------------------------------------
# SYNTHETIC 24/7 TARGET ENDPOINTS
# ------------------------------------------------------------------------------
FRONTEND_URL="https://khmer-ai-16c.pages.dev"
BACKEND_HEALTH_URL="https://khmer-ai-1ktp.onrender.com/api/health"
BACKEND_READY_URL="https://khmer-ai-1ktp.onrender.com/api/ready"
