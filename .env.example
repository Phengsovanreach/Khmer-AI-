# ==============================================================================
# KHMER TRANSLATOR 2.0 - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Khmer Translator API"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# Storage Directories & Upload Limits
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
JOBS_FILE="jobs.json"
MAX_UPLOAD_MB=2048

# Speech Recognition & AI Models
DEFAULT_WHISPER_MODEL="tiny"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Allowed Cross-Origin Origins (CORS)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://khmer-ai-16c.pages.dev"


# ------------------------------------------------------------------------------
# FRONTEND SETTINGS
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:8000"


# ------------------------------------------------------------------------------
# 24/7 AUTONOMOUS CLOUD MONITORING & SELF-HEALING SETTINGS
# ------------------------------------------------------------------------------
# Production Synthetic Target Endpoints
FRONTEND_URL="https://khmer-ai-16c.pages.dev"
BACKEND_HEALTH_URL="https://khmer-ai-1ktp.onrender.com/api/health"
BACKEND_READY_URL="https://khmer-ai-1ktp.onrender.com/api/ready"

# Telegram Bot Alert Credentials (Obtain from @BotFather)
# Required in GitHub Secrets as TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Provider Credentials (Optional: used for root-cause analysis)
# Required in GitHub Secrets as GEMINI_API_KEY
AI_PROVIDER="auto"
GEMINI_API_KEY=
OPENAI_API_KEY=
