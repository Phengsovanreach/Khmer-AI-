# ==============================================================================
# KHMER TRANSLATOR 2.0 - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Khmer Translator API"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# Storage Directories & Upload Limits
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
JOBS_FILE="jobs.json"
MAX_UPLOAD_MB=2048

# Speech Recognition & AI Models
DEFAULT_WHISPER_MODEL="tiny"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Allowed Cross-Origin Origins (CORS)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://khmer-ai-16c.pages.dev"


# ------------------------------------------------------------------------------
# FRONTEND SETTINGS
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:8000"
